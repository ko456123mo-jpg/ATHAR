APP_NAME=ATHAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────
#  قاعدة البيانات / Database
#  القيمة الافتراضية هنا للتطوير المحلي السريع (SQLite).
#  للإنتاج استخدم MySQL 8 — راجع docs/LOCAL_SETUP.md
# ─────────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=athar
# DB_USERNAME=athar_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
# للإنتاج مع Redis: QUEUE_CONNECTION=redis
# CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────
#  إعدادات ATHAR الجنائية / ATHAR forensics settings
#  تُقرأ في config/forensics.php و config/filesystems.php
# ─────────────────────────────────────────────────────────────────────

# قرص تخزين الأدلة — يجب أن يكون خاصاً (غير منشور للعامة)
ATHAR_EVIDENCE_DISK=private

# أقصى حجم لرفع الدليل الواحد (كيلوبايت) — الافتراضي 20 MB
ATHAR_MAX_EVIDENCE_UPLOAD_KILOBYTES=20480

# أقصى حجم لنتيجة يعيدها الـ Agent (بايت) — الافتراضي 10 MB
# (مُعرَّف في config/forensics.php وقابل للضبط، لكنه غير مُستهلك بعد في الكود)
ATHAR_AGENT_RESULT_LIMIT_BYTES=10485760
